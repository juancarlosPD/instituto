{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "python manage.py collectstatic --noinput"
  },
  "deploy": {
    "startCommand": "python manage.py migrate --noinput && gunicorn perea.wsgi:application --bind 0.0.0.0:$PORT --workers 1 --access-logfile - --error-logfile -"
  }
}
